# Copy to .env (gitignored) and fill in. dotenv loads this at process start
# (see app.js). For production, prefer injecting these via systemd /
# docker-compose env_file rather than checking a .env into the deploy image.

# Required — express-session signing key. Any non-empty string. Use a long
# random value in any deploy that sees real users; "test" is fine for local.
SESSION_SECRET=test

# Path (relative or absolute) to the gramene-auth Firebase service-account
# JSON. The bundled file is shipped in the repo root; production hosts
# typically keep it under /usr/local/gramene/.
FIREBASE_CREDENTIALS_PATH=./gramene-auth-firebase-adminsdk-c1sc0-263ff4cc4f.json

# Google OAuth credentials for passport-google-oauth20. Optional unless you
# need the legacy /auth/google login flow — Firebase ID tokens (used by
# /gene_lists, /saved_views, etc.) don't need these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
